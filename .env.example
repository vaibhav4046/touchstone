# Copy to .env.local and fill in. Never commit a filled-in file — .gitignore
# keeps every .env* out of the repository except this template.

# Claim analysis and prompt-injection classification (Groq).
# Optional: without it the deterministic dimensions still run, and the receipt
# names the checks that did not.
GROQ_API_KEY=

# Second supplier for the analyst calls only, used when Groq is rate-limited.
# Optional: the classifier has no substitute and is simply reported missing.
GEMINI_API_KEY=

# HMAC key for receipt signatures and escalation tickets.
# REQUIRED in production: with it unset the service refuses to sign or verify
# rather than falling back to a key that is published in this repository.
# Rotating it invalidates every prior receipt, which is intended, not a hazard.
TOUCHSTONE_SIGNING_KEY=

# Operator secret for POST /api/escalations, sent as the x-operator-key header.
# Deciding an escalation mints a grant, and the ticket id is visible to the
# party that asked for it, so the decision needs a credential that party never
# sees. Unset means no escalation can be approved on this deployment.
TOUCHSTONE_OPERATOR_KEY=

# Ships kernel decisions to SharedOS Cloud. Optional: audit stays local without it.
SHAREDOS_KEY=

# Base URL advertised in /api/manifest. Defaults to https://yuzu-market.vercel.app.
TOUCHSTONE_BASE_URL=
